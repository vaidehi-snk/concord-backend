PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/concord
JWT_SECRET=replace_with_a_long_random_string
GEMINI_API_KEY=your_free_key_from_aistudio.google.com
# Optional: pin a Gemini model (otherwise tries gemini-3.6-flash, gemini-3-flash, gemini-2.5-flash)
GEMINI_MODEL=
# Optional: comma-separated frontend origins allowed to call the API (default: any). Wildcards OK:
# CORS_ORIGINS=https://concord-frontend-five.vercel.app,https://concord-frontend-*.vercel.app
CORS_ORIGINS=
